{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_version": "22.0.0",
  "include": [
      "src/**/*",
  ],
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node16",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "baseUrl": ".",
    "paths": {
      "@/*":["./src/*"]
    }
  }
}